    "smoke": "node scripts/smoke.mjs",
    "smoke:lazorkit": "node scripts/lazorkit-smoke.mjs"
  },
  "dependencies": {
    "@solana/web3.js": "1.99.0",
    "bs58": "6.0.0"
  },
  "devDependencies": {
    "@lazorkit/sdk-legacy": "1.2.0"
  }
}
