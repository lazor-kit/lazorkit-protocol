{
  "name": "lazorkit-tests-sdk",
  "version": "1.0.0",
  "private": true,
  "description": "LazorKit SDK integration tests (sdk-legacy + @solana/web3.js v1)",
  "scripts": {
    "test": "vitest run --fileParallelism=false",
    "test:watch": "vitest --fileParallelism=false",
    "test:local": "npm run validator:start; npm run validator:wait && npm test; npm run validator:stop",
    "validator:start": "../scripts/start-validator.sh",
    "validator:wait": "../scripts/wait-for-validator.sh",
    "validator:stop": "pkill -f solana-test-validator || true",
    "benchmark": "npx tsx tests/benchmark.ts"
  },
  "dependencies": {
    "@solana/web3.js": "^3.1.1",
    "ecdsa-secp256r1": "^1.3.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "jayson": "^5.0.0"
  }
}
